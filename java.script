async function shorten() {
    const longUrl = document.getElementById('longUrl').value;
    const resultElement = document.getElementById('shortResult');
    
    if(!longUrl) return alert("Введите ссылку!");

    resultElement.innerText = "Сокращаем...";

    try {
        // Используем бесплатное API TinyURL
        const response = await fetch(`https://tinyurl.com/api-create.php?url=${encodeURIComponent(longUrl)}`);
        if (response.ok) {
            const shortUrl = await response.text();
            resultElement.innerHTML = `Готово: <a href="${shortUrl}" target="_blank">${shortUrl}</a>`;
        } else {
            resultElement.innerText = "Ошибка при сокращении.";
        }
    } catch (error) {
        resultElement.innerText = "Сервис временно недоступен.";
    }
}
